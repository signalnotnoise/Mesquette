# Copy to asset-pack-upload.env (gitignored) and fill in.
# App Store Connect → Mesquette → App Information → Apple ID (numeric, not the email).
ASC_APP_APPLE_ID=

# Preferred: Users and Access → Integrations → App Store Connect API
ASC_API_KEY=
ASC_API_ISSUER=
# Optional if AuthKey_<ASC_API_KEY>.p8 is not in the default search paths:
# ASC_P8_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Alternative to the API key: Apple ID email + app-specific password
# ASC_USERNAME=
# ASC_PASSWORD_KEYCHAIN=AC_PASSWORD
# ASC_PASSWORD=
